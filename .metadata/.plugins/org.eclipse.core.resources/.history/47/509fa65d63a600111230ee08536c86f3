package aula03;

import java.util.Scanner;

public class Abastecimento {
	
	public static void main(String[] args) {
		Scanner scanner = new Scanner(System.in);
		int quantidadeTotal = scanner.nextInt();
		
		scanner.nextLine();
		String aguaCidades = scanner.nextLine();
		
		String [] abastecimento = aguaCidades.split(" ");
		int c1 = Integer.parseInt(abastecimento[0]);
		int c2 = Integer.parseInt(abastecimento[0]);
		int c3 = Integer.parseInt(abastecimento[0]);
		int c4 = Integer.parseInt(abastecimento[0]);
		int c5 = Integer.parseInt(abastecimento[0]);
		
		int necessidade = c1 + c2 + c3 + c4 + c5;
		
		if(quantidadeTotal == necessidade) {
			System.out.println("Abastece perfeitamente.");
		} else if(necessidade > quantidadeTotal) {
			System.out.println("Insuficiente.");
		} else {
			int sobra = quantidadeTotal - necessidade;
			System.out.println("Abastece e sobra: "+sobra);
		}
		
	}

}
