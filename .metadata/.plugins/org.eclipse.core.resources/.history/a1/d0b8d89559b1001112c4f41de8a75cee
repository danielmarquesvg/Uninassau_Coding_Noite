package aula04_Repeticao;

import java.util.Scanner;

public class Calculadora {
	
	public static void main(String[] args) {
		Scanner scanner = new Scanner(System.in);
		
		int opcao = -1;
		
		while(opcao != 5) {
			System.out.print("=== CALCULADORA DA SHOPEE ===");
			System.out.println(); //pular linha
			System.out.print("Opções\n");
			System.out.print("1 - soma\n");
			System.out.print("2 - subtração\n");
			System.out.print("3 - multiplicação\n");
			System.out.print("4 - divisão\n");
			System.out.print("5 - Sair da calculadora\n");
			System.out.println(); //pular linha
			System.out.print("Digite uma opção: ");
			opcao = scanner.nextInt();
			
			if(opcao == 1) {
				System.out.print("Digite o primeiro valor: ");
				int valor1 = scanner.nextInt();
				System.out.print("Digite o segundo valor: ");
				int valor2 = scanner.nextInt();
				int soma = valor1 + valor2;
				System.out.println("Soma = "+soma);
				
			} else if(opcao == 2) {
				System.out.print("Digite o primeiro valor: ");
				int valor1 = scanner.nextInt();
				System.out.print("Digite o segundo valor: ");
				int valor2 = scanner.nextInt();
				int subtracao = valor1 - valor2;
				System.out.println("Subtração = "+subtracao);
				
			} else if(opcao == 3) {
				System.out.print("Digite o primeiro valor: ");
				int valor1 = scanner.nextInt();
				System.out.print("Digite o segundo valor: ");
				int valor2 = scanner.nextInt();
				int multiplicacao = valor1 * valor2;
				System.out.print("Multiplicação = "+multiplicacao);
				
			} else if(opcao == 4) {
				System.out.print("Digite o primeiro valor: ");
				double valor1 = scanner.nextDouble();
				System.out.print("Digite o segundo valor: ");
				double valor2 = scanner.nextDouble();
				
				if(valor2 == 0) {
					System.out.print("Não é possível determinar um resultado");
				} else {
					double divisao = valor1 / valor2;
					System.out.printf("Divisão = %.2f",divisao);
				}
			} else if(opcao == 5) {
				System.out.print("Encerrando a calculadora");
			} else {
				System.out.println("Opção inválida");
			}
		}
		
	}

}
