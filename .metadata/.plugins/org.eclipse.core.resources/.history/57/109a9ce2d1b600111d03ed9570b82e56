		//instanciação
		String nome;
		String [] listinha;
		
		//inicialização
		nome = "Daniel";
		listinha = new String [100];
		
		String [] listaDeCompras = new String [100];
		
		//adicionando elementos
		listinha[0] = "Jefferson";
		listinha[20] = "Januário";
		listinha[16] = "Esthefany";
		listinha[66] = "Pedro";
		listinha[20] = "Luiz";
		
